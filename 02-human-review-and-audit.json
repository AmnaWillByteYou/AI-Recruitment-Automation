    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const form = $('Recruiter Review Form').first().json;\nconst rows = $input.all().map(x=>x.json||{});\nconst id = String(form['Candidate ID']??'').trim();\nconst decisionRaw = String(form.Decision??'').trim().toLowerCase();\nconst reviewer = String(form['Reviewer Name']??'').trim();\nconst notes = String(form['Review Notes']??'').trim();\nconst allowed = {\n 'shortlist':'Shortlisted',\n 'reject':'Rejected by Recruiter',\n 'hold':'On Hold',\n 'request more information':'More Information Requested'\n};\nif (!id || !reviewer || !notes) throw new Error('Candidate ID, reviewer name and review notes are required.');\nif (!allowed[decisionRaw]) throw new Error('Decision must be Shortlist, Reject, Hold, or Request More Information.');\nconst found = rows.find(r=>String(r['Candidate ID']??'').trim()===id);\nif (!found) throw new Error(`No candidate found for Candidate ID ${id}.`);\nconst now = new Date().toISOString();\nconst status = allowed[decisionRaw];\nconst updated = {\n ...found,\n 'Candidate ID':id,\n Status:status,\n Reviewer:reviewer,\n 'Review Decision':decisionRaw.replace(/\\\\b\\\\w/g,c=>c.toUpperCase()),\n 'Review Notes':notes,\n 'Last Updated':now\n};\nreturn [{json:{\n ...updated,\n 'Review Event ID':`REV-${now.replace(/[-:.TZ]/g,'')}-${Math.random().toString(36).slice(2,6).toUpperCase()}`,\n 'Previous Status':String(found.Status??'Unknown'),\n 'New Status':status,\n Decision:decisionRaw.replace(/\\\\b\\\\w/g,c=>c.toUpperCase()),\n 'Reviewed At':now\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
