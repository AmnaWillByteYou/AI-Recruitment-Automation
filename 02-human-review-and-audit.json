    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a professional recruiting coordinator. Draft a respectful candidate email based only on the recruiter's explicit human decision and supplied facts. Never invent dates, times, links, salary, benefits, promises, or interview arrangements. Do not mention AI scores or automated ranking. For a shortlist, invite the candidate to reply with availability; this is not a job offer. For rejection, be courteous and do not criticize the person. For a request for more information, state only the specific clarification in the recruiter notes. Return only the email body."
            },
            {
              "content": "Human-approved decision: {{ $json.Decision }}\nCandidate name: {{ $json.Name }}\nRole: {{ $json['Role Title'] }}\nRecruiter notes: {{ $json['Review Notes'] }}\n\nWrite the appropriate candidate email. Do not add details not supplied."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
